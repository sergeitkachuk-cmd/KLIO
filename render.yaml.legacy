# Archived configuration.
#
# This file used to deploy the complete KLIO application and a Render
# PostgreSQL database. The main application now runs on Timeweb App Platform;
# Render is used only for the Telegram + image/GPT relay. Keep this file for
# historical reference, but do not rename it back to render.yaml or use it as
# a new Render Blueprint without an explicit architecture decision.

services:
  - type: web
    name: klio
    runtime: node
    plan: starter
    branch: main
    buildCommand: npm ci && npm run build
    preDeployCommand: npm run db:push
    startCommand: npm start
    healthCheckPath: /api/ai-status
    envVars:
      - key: NODE_VERSION
        value: 22.13.0
      - key: DATABASE_URL
        fromDatabase:
          name: klio-db
          property: connectionString
      - key: OPENAI_API_KEY
        sync: false
      - key: DEEPSEEK_API_KEY
        sync: false
      - key: AI_PROVIDER
        value: deepseek
      - key: YANDEX_SEARCH_API_KEY
        sync: false
      - key: YANDEX_FOLDER_ID
        sync: false
      - key: DADATA_API_KEY
        sync: false
      - key: TAVILY_API_KEY
        sync: false
      - key: TAVILY_MONTHLY_CREDIT_LIMIT
        sync: false
      - key: RENDER_API_KEY
        sync: false
      - key: GITHUB_BILLING_TOKEN
        sync: false
      - key: GITHUB_BILLING_ACCOUNT
        sync: false
      - key: GITHUB_BILLING_SCOPE
        sync: false
      - key: ADMIN_EMAILS
        sync: false
      - key: UNISENDER_GO_API_KEY
        sync: false
      - key: UNISENDER_FROM_EMAIL
        sync: false
      - key: UNISENDER_BACKEND_ID
        sync: false
      - key: APP_BASE_URL
        sync: false

databases:
  - name: klio-db
    plan: free
