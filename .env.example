# Server-only — never sent to the browser. Which model handles which
# operation is not an env setting: the AI router (app/api/_lib/ai-config.ts)
# always picks the CONTENT/UTILITY model for the active provider per
# operation. AI_PROVIDER switches provider for every operation at once;
# leave unset (or anything other than "deepseek") to stay on OpenAI.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
AI_PROVIDER=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/klio
# Comma-separated list of emails allowed to open /admin (users, plan usage,
# AI token/cost spend). Empty/unset means nobody can open it.
ADMIN_EMAILS=
# Local-dev only convenience: skips /login and treats every request as this
# user. Never applied in production (see app/chatgpt-auth.ts).
APP_USER_EMAIL=
APP_USER_NAME=
# Required for /signup to send verification emails — get a key at
# https://go.unisender.ru (Unisender Go transactional email). Both are
# required in production; the from-address domain must be verified there
# (SPF/DKIM) or delivery fails.
UNISENDER_GO_API_KEY=
UNISENDER_FROM_EMAIL=
# Optional: numeric Backend ID from Unisender Go's "Домены ссылок" page,
# once noreply.<domain> shows status "Настроен". Pins sending to that
# tracking/backend domain explicitly instead of relying on the account's
# default pick.
UNISENDER_BACKEND_ID=
# Public URL used to build the verification link emailed to new users.
# Required in production — behind Render's proxy, request.url reflects the
# internal 0.0.0.0:PORT bind address, not the public hostname. Leave unset
# locally: http://localhost:3000 is derived correctly on its own.
APP_BASE_URL=
# Yandex Search API / Wordstat. Create these in Yandex Cloud; keep the key
# server-only and never commit it. Required for real search-demand data in
# the Semantics module.
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
