# Server-only — never sent to the browser. Which model handles which
# operation is not an env setting: the AI router (app/api/_lib/ai-config.ts)
# always picks the CONTENT/UTILITY model for the active provider per
# operation. AI_PROVIDER switches provider for every operation at once;
# leave unset (or anything other than "deepseek") to stay on OpenAI.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
AI_PROVIDER=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/klio
# DaData party suggestions for autofilling company/IP requisites on invoices.
# Server-only; never expose as NEXT_PUBLIC_*.
DADATA_API_KEY=
# Comma-separated list of emails allowed to open /admin (users, plan usage,
# AI token/cost spend). Empty/unset means nobody can open it.
ADMIN_EMAILS=
# Local-dev only convenience: skips /login and treats every request as this
# user. Never applied in production (see app/chatgpt-auth.ts).
APP_USER_EMAIL=
APP_USER_NAME=
# Required for /signup to send verification emails — get a key at
# https://go.unisender.ru (Unisender Go transactional email). Both are
# required in production; the from-address domain must be verified there
# (SPF/DKIM) or delivery fails.
UNISENDER_GO_API_KEY=
UNISENDER_FROM_EMAIL=
# Optional: numeric Backend ID from Unisender Go's "Домены ссылок" page,
# once noreply.<domain> shows status "Настроен". Pins sending to that
# tracking/backend domain explicitly instead of relying on the account's
# default pick.
UNISENDER_BACKEND_ID=
# Public URL used to build the verification link emailed to new users.
# Required in production — behind Render's proxy, request.url reflects the
# internal 0.0.0.0:PORT bind address, not the public hostname. Leave unset
# locally: http://localhost:3000 is derived correctly on its own.
APP_BASE_URL=
# Numeric Yandex Metrica counter ID (from the counter's "Номер счётчика" in
# metrika.yandex.ru). Leave unset to keep the site untracked (local/staging).
# The tag itself only ever loads after a visitor accepts cookies in the
# banner (see app/yandex-metrica.tsx) — setting this alone doesn't start
# tracking anyone who hasn't consented.
YANDEX_METRICA_ID=
# "Войти через Яндекс" (see app/api/auth/yandex/*). Register an OAuth app at
# https://oauth.yandex.ru/client/new — platform "Веб-сервисы", redirect URI
# exactly "<APP_BASE_URL>/api/auth/yandex/callback", permissions "Доступ к
# email" (login:email) and "Доступ к имени, фамилии и полу" (login:info).
# Client secret is server-only, never expose as NEXT_PUBLIC_*. Leave both
# unset to hide the button's effect — it still renders, but redirects back
# with an "unavailable" message instead of reaching Yandex.
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
# "Войти через VK" (see app/api/auth/vk/*, app/api/_lib/vk-oauth.ts) — VK ID
# (id.vk.com), not the older classic oauth.vk.com. Register an app at
# https://id.vk.com/business (VK ID для бизнеса) or vk.com/apps?act=manage,
# platform "Веб-сайт", redirect URI exactly
# "<APP_BASE_URL>/api/auth/vk/callback". No client secret needed — this flow
# uses PKCE instead (VK ID requires it; Yandex's flow above doesn't use it).
# Leave unset to hide the button's effect — see YANDEX_OAUTH_CLIENT_ID above.
VK_OAUTH_CLIENT_ID=
# Yandex Search API / Wordstat. Create these in Yandex Cloud; keep the key
# server-only and never commit it. Required for real search-demand data in
# the Semantics module.
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
# Optional bounded web-research layer for content plans. It runs at most one
# Tavily request per topic/geography combination and caches the digest for 24h.
# Keep this server-only; do not expose it as NEXT_PUBLIC_*.
TAVILY_API_KEY=
# Optional: the monthly credit limit of your actual Tavily tariff. It is used
# only to calculate the remaining credits in /admin; do not guess this value.
TAVILY_MONTHLY_CREDIT_LIMIT=
# Tochka internet acquiring. Keep both values server-only in the hosting
# provider; customer/merchant IDs are optional and can be discovered once the
# acquiring connection is active.
TOCHKA_JWT_TOKEN=
TOCHKA_CLIENT_ID=
TOCHKA_CUSTOMER_CODE=
TOCHKA_MERCHANT_ID=
# Required for B2B invoices: accountId of the enabled settlement account
# that should receive invoice payments.
TOCHKA_ACCOUNT_ID=
# Optional tokens for the owner-only external-services block in /admin.
# Render's API reports service state, but not the exact accrued invoice.
RENDER_API_KEY=
# GitHub token needs the "Plan: read" account permission. Set scope to user
# for a personal account or org for an organization.
GITHUB_BILLING_TOKEN=
GITHUB_BILLING_ACCOUNT=
GITHUB_BILLING_SCOPE=user
